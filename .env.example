# Public URL the vault is reached on.
#
# Passkeys require a secure context, so this must be https:// for anything
# other than localhost. WebAuthn assertions are verified against this origin
# and share links are built from it — if it is wrong, sign-in fails and share
# links point somewhere useless.
APP_URL=https://vault.example.com

# WebAuthn Relying Party ID: the registrable domain, with no scheme or port.
# Leave blank to derive it from APP_URL's hostname, which is usually correct.
WEBAUTHN_RP_ID=

# How many accounts may exist. Registration is refused past this.
MAX_USERS=3

# Per-file upload ceiling and per-user storage quota, in bytes.
# Defaults: 100 MB per file, 1 GB per user.
MAX_FILE_SIZE_BYTES=104857600
MAX_USER_QUOTA_BYTES=1073741824

# How long a sign-in lasts before the passkey is required again, in minutes.
SESSION_TTL_MINUTES=60

# Database credentials. Change POSTGRES_PASSWORD before deploying.
POSTGRES_USER=vaultUser
POSTGRES_PASSWORD=change_me_before_deploying
POSTGRES_DB=vault

# Host port to publish the app on.
PORT=3000
